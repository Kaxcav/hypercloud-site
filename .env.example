# Domain & Public URL
NEXT_PUBLIC_SITE_URL=https://www.hypercloud.com.br

# Ecossistema Hypercloud — navegação cruzada entre portais (spec DESIGN-SYSTEM-HYPERCLOUD §5.1)
# HSM (Hypercloud Support Manager) — em dev roda no Vite em http://localhost:5173
NEXT_PUBLIC_HSM_URL=http://localhost:5173
# HLM (Hypercloud License Manager) — em dev roda com `next dev -p 3001` para não colidir com o site
NEXT_PUBLIC_HLM_URL=http://localhost:3001

# Integração server-to-server (BFF — sem NEXT_PUBLIC_)
HSM_API_URL=http://localhost:3002/api
HLM_API_URL=http://localhost:3001/api

# Resend Email Integration
RESEND_API_KEY=re_123456789
LEAD_NOTIFY_EMAIL=comercial@hypercloud.com.br
LEAD_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Analytics & Tracking
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=1234567

# Authentication (Portal do Cliente / Dashboard)
# Gere um segredo real com: openssl rand -base64 32
NEXTAUTH_SECRET=gere-um-segredo-aleatorio-forte
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Credenciais do usuário demo do portal — defina valores PRÓPRIOS por ambiente.
# NUNCA use os valores deste template em produção (repositório é público).
PORTAL_USER_EMAIL=usuario@exemplo.com.br
PORTAL_USER_PASSWORD=defina-uma-senha-forte
